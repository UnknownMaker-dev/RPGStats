{
  // HUD do RPGStats. O plugin manda os dados pelo título (veja ui/rpgstats/hud.json);
  // aqui o título com o prefixo "rpgh:" é escondido e o painel é inserido na tela.
  "namespace": "hud",

  "hud_title_text/title_frame": {
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "title",
        "source_property_name": "((#text - 'rpgh:') = #text)",
        "target_property_name": "#visible"
      }
    ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "rpgstats_hud@rpgstats_hud.painel": {} }
        ]
      }
    ]
  }
}
