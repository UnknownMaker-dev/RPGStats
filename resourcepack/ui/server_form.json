{
  // Formulários do RPGStats com o visual do pack. Só os formulários cujo título traz
  // a marca invisível "§r§p§g§r" (src/RPGStats/Form/MenuForm.php) trocam de cara;
  // todos os outros continuam com a tela padrão.
  "namespace": "server_form",

  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "rpgstats_formulario@rpgstats_form.raiz": {} }
        ]
      }
    ]
  },

  // A janela padrão de lista some quando o formulário é do RPGStats.
  "long_form": {
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text - '§r§p§g§r') = #title_text)",
        "target_property_name": "#visible"
      }
    ]
  }
}
