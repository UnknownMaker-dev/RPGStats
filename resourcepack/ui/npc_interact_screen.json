{
  // Acrescenta a ficha do RPGStats à tela de diálogo de NPC sem tirar nada dela.
  // A ficha só aparece quando o nome do diálogo traz "rpgstats|"; nos outros NPCs a
  // tela padrão continua igual.
  "namespace": "npc_interact",

  "npc_screen_contents": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "rpgstats_ficha@rpgstats_ficha.raiz": {} }
        ]
      }
    ]
  },

  // A janela padrão do jogador (aluno) some quando a ficha está aberta.
  "npc_screen_contents/student": {
    "bindings": [
      { "binding_name": "#student_view_visible", "binding_type": "global" },
      { "binding_name": "#title_text", "binding_type": "global" },
      {
        "binding_type": "view",
        "source_property_name": "(#student_view_visible and ((#title_text - 'rpgstats|') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  }
}
